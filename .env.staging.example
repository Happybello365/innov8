# .env.staging.example — copy to .env.staging and fill in real values
# NEVER commit .env.staging to version control

# ── Staging Database ─────────────────────────────────────────────────────────
STAGING_POSTGRES_USER=postgres
STAGING_POSTGRES_PASSWORD=change-me-staging-db-password
STAGING_POSTGRES_DB=amana_staging
STAGING_POSTGRES_PORT=5434
STAGING_DATABASE_URL=postgresql://postgres:change-me-staging-db-password@localhost:5434/amana_staging

# ── Staging Redis ────────────────────────────────────────────────────────────
STAGING_REDIS_PASSWORD=change-me-staging-redis-password
STAGING_REDIS_PORT=6380
STAGING_REDIS_URL=redis://:change-me-staging-redis-password@localhost:6380/0

# ── Backend app config ───────────────────────────────────────────────────────
NODE_ENV=staging
PORT=4000

JWT_SECRET=change-me-staging-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=86400

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
AMANA_CONTRACT_ID=
AMANA_ESCROW_CONTRACT_ID=CCY3G5O6M7K8N9P0Q1R2S3T4U5V6W7X8Y9Z0A1B2C3

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

AUDIT_SIGNING_KEY_ID=amana-audit-key-staging-v1
AUDIT_SIGNING_PRIVATE_KEY_PEM=
AUDIT_SIGNING_PUBLIC_KEY_PEM=

# ── Admin feature flag ────────────────────────────────────────────────────────
# Set to "true" to enable admin routes; defaults to "false" (disabled/safe state)
ADMIN_ROUTES_ENABLED=false

# ── Webhook ────────────────────────────────────────────────────────────────────
# Optional: URL to receive trade status change notifications
WEBHOOK_URL=
# Optional: shared secret for HMAC-SHA256 payload signing
WEBHOOK_SECRET=

# ── Canary deployment traffic controls ────────────────────────────────────────
# Staged traffic shifting for backend and frontend releases. The deploy
# workflow promotes a release through these weight steps in order; each step
# is observed for CANARY_STEP_DURATION_SECONDS before advancing. Weights are
# percentages of total traffic routed to the canary (0-100).
CANARY_TRAFFIC_STEPS=5,25,50,100
CANARY_STEP_DURATION_SECONDS=300

# Automated rollback criteria. If any threshold is breached during a canary
# step, traffic is shifted back to the stable release and the rollout aborts.
# Error rate is a fraction (0-1); latency is in milliseconds (p95).
CANARY_MAX_ERROR_RATE=0.02
CANARY_MAX_P95_LATENCY_MS=800
# Minimum consecutive failed health probes before triggering rollback.
CANARY_HEALTH_FAILURE_THRESHOLD=3
# When "true", a breached threshold aborts the rollout automatically.
CANARY_AUTO_ROLLBACK=true
