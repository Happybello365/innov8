PORT=4000
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_REFRESH_WINDOW_MS=900000
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=30
RATE_LIMIT_DISPUTE_WINDOW_MS=3600000
RATE_LIMIT_DISPUTE_MAX=5

# Brute-force account lockout (issue #556) — see docs/brute-force-lockout.md.
# Risk-based lockout for login and wallet challenge attempts. Counters are keyed
# on a hashed identifier (never raw email/wallet/IP) and reset on successful auth.
# Set BRUTE_FORCE_LOCKOUT_ENABLED=false to disable enforcement (not recommended).
BRUTE_FORCE_LOCKOUT_ENABLED=true
# Sliding window (ms) over which failed attempts are counted.
BRUTE_FORCE_WINDOW_MS=900000
# Failed attempts allowed before lockout is triggered.
BRUTE_FORCE_MAX_ATTEMPTS=5
# Base lockout duration (ms); escalates with repeated lockouts up to the cap.
BRUTE_FORCE_LOCKOUT_MS=900000
BRUTE_FORCE_LOCKOUT_MAX_MS=86400000
# Number of prior lockouts within the window that trigger escalation.
BRUTE_FORCE_ESCALATION_THRESHOLD=3

# Admin operation quotas (per admin wallet or x-api-key, expensive/high-volume routes)
ADMIN_QUOTA_CLAWBACK_WINDOW_MS=3600000
ADMIN_QUOTA_CLAWBACK_MAX=10
ADMIN_QUOTA_TRADE_BATCH_WINDOW_MS=3600000
ADMIN_QUOTA_TRADE_BATCH_MAX=20

# Retry/backoff for admin Soroban transaction submission (transient RPC failures)
SOROBAN_SUBMIT_MAX_RETRIES=3
SOROBAN_SUBMIT_BACKOFF_MS=1000,2000,4000,8000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/amana
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars-change-in-production!
JWT_EXPIRES_IN=86400
JWT_ISSUER=amana
JWT_AUDIENCE=amana-api
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=
API_PUBLIC_URL=

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=

# Buffered fee estimation for network congestion (issue #184) — all optional
STELLAR_FEE_PERCENTILE=p90
STELLAR_FEE_SAFETY_MULTIPLIER=1.5
STELLAR_FEE_CONGESTION_BOOST=2
STELLAR_FEE_CONGESTION_CAPACITY=0.75
STELLAR_FEE_CONGESTION_FEE_RATIO=4
STELLAR_FEE_MIN_STROOPS=100
STELLAR_FEE_MAX_STROOPS=1000000
STELLAR_FEE_BUMP_FACTOR=1.5
STELLAR_FEE_MAX_RETRIES=3

CONTRACT_ID=
AMANA_ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_CONTRACT_ID=CYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
ADMIN_STELLAR_PUBKEYS=
# Required at startup whenever admin routes are enabled (they always are). Server fails
# fast with a fatal log if this is missing - see docs/api/admin.md.
ADMIN_SECRET_KEY=

# Admin session device binding (issue #198) — see docs/admin-session-device-binding.md
ADMIN_SESSION_BINDING_ENABLED=false
ADMIN_SESSION_BINDING_ENFORCE=false
ADMIN_BOUND_JWT_EXPIRES_IN=900
ADMIN_IP_V4_PREFIX_BITS=24
ADMIN_IP_V6_PREFIX_BITS=48
# Hard timeout (ms) for admin routes that build Soroban transactions via RPC
ADMIN_ROUTE_TIMEOUT_MS=15000

# Admin privileged-action step-up authentication (issue #555) — see
# docs/admin-step-up-auth.md. High-impact contract and key-management actions
# require a recent strong re-authentication; requests without a fresh step-up
# are rejected with 401 and a step-up challenge. Set the window to 0 to disable
# enforcement (not recommended in production).
ADMIN_STEP_UP_ENABLED=true
ADMIN_STEP_UP_WINDOW_MS=300000
ADMIN_STEP_UP_MAX_ATTEMPTS=5
ADMIN_STEP_UP_LOCKOUT_MS=900000

# Pinata / IPFS
PINATA_API_KEY=
PINATA_SECRET=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_GATEWAY_URLS=
IPFS_GATEWAY_ALLOWLIST=
IPFS_UPLOAD_TIMEOUT_MS=10000
IPFS_STREAM_TIMEOUT_MS=5000
IPFS_PINATA_CIRCUIT_FAILURE_THRESHOLD=3
IPFS_PINATA_CIRCUIT_COOLDOWN_MS=30000
IPFS_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
IPFS_GATEWAY_CIRCUIT_COOLDOWN_MS=30000
# Private/signature-aware IPFS gateway settings for dispute-evidence downloads
IPFS_URL_SIGNING_SECRET=
IPFS_URL_TTL_SECONDS=300

# Evidence / manifest
EVIDENCE_MAX_BYTES=52428800
EVIDENCE_METADATA_RETENTION_DAYS=90
EVIDENCE_SCAN_REQUIRED=false
MANIFEST_PII_RETENTION_DAYS=30

# Soroban event listener
EVENT_POLL_INTERVAL_MS=10000
BACKOFF_INITIAL_MS=1000
BACKOFF_MAX_MS=30000
PROCESSED_LEDGERS_CACHE_SIZE=10000
EVENT_OUTBOX_MAX_ATTEMPTS=5

# Distributed tracing (optional)
JAEGER_ENDPOINT=
ZIPKIN_ENDPOINT=
PROMETHEUS_PORT=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_JAEGER_AGENT_HOST=
OTEL_EXPORTER_JAEGER_AGENT_PORT=

# Tail-based trace sampling (#231)
# Fraction of healthy (non-error, non-high-value) requests to sample. Default 10%.
TRACE_BASELINE_RATE=0.1
# Keep spans slower than this threshold (ms) regardless of route. Default 2s.
TRACE_SLOW_THRESHOLD_MS=2000
# JSON map of route-substring → rate overrides, e.g. {"\/wallet":0.2,"\/stellar\/fees":0.01}
TRACE_ROUTE_OVERRIDES={}

# Audit export signing (Ed25519 PEM keys)
AUDIT_SIGNING_KEY_ID=amana-audit-key-v1
AUDIT_SIGNING_PRIVATE_KEY_PEM=
AUDIT_SIGNING_PUBLIC_KEY_PEM=

# Webhooks (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=
# Replay protection (issue #554): reject deliveries whose signed timestamp is
# outside ±WEBHOOK_REPLAY_WINDOW_MS of server time, and reject nonce reuse
# within WEBHOOK_NONCE_TTL_MS. See docs/webhook-replay-protection.md.
WEBHOOK_REPLAY_WINDOW_MS=300000
WEBHOOK_NONCE_TTL_MS=600000
WEBHOOK_NONCE_CACHE_MAX=10000

# Ops alert webhook (cache/DB failures; separate from trade webhooks)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MS=300000

# Pilot per-trade amount cap in USDC (#127). Leave empty for no cap.
# Lift at runtime without a redeploy by setting the `pilot_trade_cap` feature flag to enabled=false.
PILOT_MAX_TRADE_AMOUNT_USDC=

# Pilot demo accounts seeded by `npm run seed` (#128) — see docs/pilot-demo-script.md.
# Testnet G... addresses you control; placeholders are used when empty.
DEMO_SELLER_ADDRESS=
DEMO_BUYER_ADDRESS=
DEMO_MEDIATOR_ADDRESS=
