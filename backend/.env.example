# Backend environment configuration example.
# Copy to .env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/innov8

# Backup verification (issue #562)
# Directory containing encrypted database backups to verify.
BACKUP_DIR=./backups
# Public key used to verify backup encryption metadata/signatures.
BACKUP_ENCRYPTION_PUBLIC_KEY=
# Maximum age (hours) a backup may have before it is considered stale.
BACKUP_MAX_AGE_HOURS=24
# When true, verification fails closed if encryption metadata is missing or invalid.
BACKUP_VERIFY_FAIL_CLOSED=true
# Retention window (days) documented for backup retention controls.
BACKUP_RETENTION_DAYS=30
