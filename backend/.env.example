# ---------------------------------------------------------------------------
# Innov8 backend environment example
# Copy to `.env` and fill in real values. Never commit real secrets.
#
# Pilot cooperative onboarding guide (issue #545)
# ------------------------------------------------
# This file documents the environment a pilot cooperative needs before it can
# be onboarded. See docs/cooperative-onboarding.md for the full guide covering
# eligibility, environment, wallet setup, funding, support, and graduation.
#
# Eligibility (checked by the onboarding team, not by this file):
#   - Registered agricultural cooperative with a verifiable legal identity.
#   - At least one operator able to hold and secure a wallet keypair.
#   - Agreement to the pilot terms and data-handling policy.
#
# Environment: copy this file to `.env`, fill in the values below, and keep the
# file out of version control. Use separate values per environment (local,
# staging, pilot). Never reuse production secrets in a pilot environment.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Database connection used by the backend. Pilot cooperatives get a dedicated
# database; do not point a pilot at the shared production database.
DATABASE_URL=postgres://user:password@localhost:5432/innov8

# Stellar network configuration for wallet setup and funding.
# Use `testnet` for pilot onboarding; switch to `mainnet` only after graduation.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Escrow contract identifier deployed for this cooperative's pilot.
ESCROW_CONTRACT_ID=

# Funding: the pilot treasury account used to fund cooperative escrows.
# Provide the public key only; never store the secret key in this file.
PILOT_FUNDING_PUBLIC_KEY=

# Support contact surfaced to cooperative operators during the pilot.
SUPPORT_EMAIL=support@example.org

# Graduation: set to `true` only after the cooperative completes the pilot
# checklist and is approved to move off the pilot configuration.
PILOT_GRADUATED=false
