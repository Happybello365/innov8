# Tracing configuration for local full-stack development.
# Copy to backend/.env (or export in your shell) and fill in real values.
# Never commit real credentials, tokens, or PII.

# Enable/disable tracing. Leave unset or "false" to disable.
TRACING_ENABLED=false

# OTLP collector endpoint. The local docker-compose stack exposes the
# collector on 4318 (HTTP) and 4317 (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Service identity used to label spans in the tracing backend.
OTEL_SERVICE_NAME=innov8-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# Sampling ratio between 0.0 and 1.0. Use 1.0 locally for full traces.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Optional headers for authenticated collectors. Keep values in your
# local .env only; do not commit real tokens.
# OTEL_EXPORTER_OTLP_HEADERS=
