# Expo environment variables
EXPO_PUBLIC_API_URL=http://localhost:4000
# Version prefix for consumer-facing API calls. Keep /api/v1 (versioned lane).
# Set empty (EXPO_PUBLIC_API_VERSION_PREFIX=) to use legacy aliases (deprecated).
EXPO_PUBLIC_API_VERSION_PREFIX=/api/v1
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# Stellar network (testnet or public)
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Push notifications
EXPO_PUBLIC_PUSH_PROVIDER=expo

# Crash reporting (issue #267). Disabled unless both are set.
EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false
EXPO_PUBLIC_CRASH_REPORT_URL=

# In-app update prompt (issue #266). JSON manifest:
# {"latestVersion":"0.2.0","iosStoreUrl":"...","androidStoreUrl":"..."}
EXPO_PUBLIC_UPDATE_CHECK_URL=
